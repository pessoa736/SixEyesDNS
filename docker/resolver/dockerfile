FROM alpine:3.20

RUN apk add --no-cache unbound \
	&& mkdir -p /var/log/unbound

COPY unbound.conf /etc/unbound/unbound.conf

# O daemon troca de usuário e não consegue criar o log num bind mount do
# host; o root cria antes, com o dono do serviço e leitura para todos.
ENTRYPOINT ["sh", "-c", "touch /var/log/unbound/unbound.log && chown unbound /var/log/unbound/unbound.log && chmod 0644 /var/log/unbound/unbound.log && exec \"$@\"", "--", "unbound", "-d", "-c", "/etc/unbound/unbound.conf"]
